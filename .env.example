# API Configuration for DLMM Wallet Screener Pro

# Helius RPC API Key (required for Solana blockchain data)
# Get your free API key at: https://helius.dev
REACT_APP_HELIUS_API_KEY=your_helius_api_key_here

# Birdeye API Key (required for wallet analytics and token data)
# Get your API key at: https://birdeye.so
REACT_APP_BIRDEYE_API_KEY=your_birdeye_api_key_here

# Meteora API Base URL (optional, defaults to https://app.meteora.ag/api)
REACT_APP_METEORA_API=https://app.meteora.ag/api

# Birdeye API Base URL (optional, defaults to https://public-api.birdeye.so)
REACT_APP_BIRDEYE_API=https://public-api.birdeye.so
